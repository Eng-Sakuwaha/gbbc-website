    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/.bin';if(fs.existsSync(p)){fs.readdirSync(p).forEach(f=>{try{fs.chmodSync(p+'/'+f,0o755)}catch(e){}})}console.log('✅ Executable permissions set')\""
