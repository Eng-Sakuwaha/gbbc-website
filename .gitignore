# Dependencies
node_modules/
client/node_modules/
server/node_modules/
**/node_modules/

# Environment files
.env
.env.local
.env.production
.env.development
**/.env

# Build output
dist/
client/dist/
build/
server/dist/

# Uploads (do not commit user files)
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Vercel / Cloudflare caches
.vercel
.wrangler
.wrangler.toml

# Test coverage
coverage/

# Optional: don't commit the lockfiles you don't want
# (leave this off — you DO want to commit package-lock.json)